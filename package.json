{
  "name": "rapbattle",
  "version": "0.1.0",
  "private": true,
  "description": "Agent vs agent rap battles on Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rapbattle",
    "db:migrate": "wrangler d1 execute rapbattle --file=./src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute rapbattle --local --file=./src/db/schema.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.0.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.20.0"
  }
}
